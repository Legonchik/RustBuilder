<Window x:Class="RustBuilder.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustBuilder — Каталог баз" Width="820" Height="580" MinWidth="700" MinHeight="480"
        Background="#FF16181B" Foreground="White" FontFamily="Segoe UI"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <Border Background="#FF16181B" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Список -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click"/>
                    <TextBlock Text="Каталог" FontSize="20" FontWeight="SemiBold"/>
                </DockPanel>
                <Grid Margin="0,8,0,0">
                    <TextBox x:Name="Search" Padding="6,4" Background="#22FFFFFF" Foreground="White"
                             BorderBrush="#33FFFFFF" CaretBrush="White" TextChanged="Search_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Поиск по названию или автору" Margin="9,5,0,0" Opacity="0.4" IsHitTestVisible="False"/>
                </Grid>
            </StackPanel>

            <ListBox x:Name="List" Grid.Row="1" Grid.Column="0" Background="#11FFFFFF" BorderThickness="0"
                     Foreground="White" SelectionChanged="List_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                <TextBlock Text="Источник (владелец/репозиторий на GitHub):" FontSize="11" Opacity="0.6"/>
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="OK" Click="SaveRepo_Click" Margin="6,0,0,0"/>
                    <TextBox x:Name="RepoBox" Padding="6,3" Background="#22FFFFFF" Foreground="White"
                             BorderBrush="#33FFFFFF" CaretBrush="White"/>
                </DockPanel>
            </StackPanel>

            <!-- Превью -->
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" Foreground="#FFE0583A" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DescText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <DockPanel Grid.Row="1" Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock x:Name="StatsText" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CostText" FontSize="12" Foreground="#FFFFB070" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" x:Name="FloorTabs"/>
                <Border Background="#33000000" CornerRadius="6">
                    <Grid>
                        <Canvas x:Name="Preview" Width="440" Height="300" ClipToBounds="True"/>
                        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="24" Opacity="0.75" FontSize="13"/>
                    </Grid>
                </Border>
            </DockPanel>

            <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" LastChildFill="False" VerticalAlignment="Bottom">
                <Button x:Name="DownloadBtn" DockPanel.Dock="Right" Content="Скачать в мои базы" Style="{StaticResource PrimaryButton}"
                        Padding="18,6" FontSize="14" Click="Download_Click" IsEnabled="False"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
