<Window x:Class="RustBuilder.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustBuilder — Редактор баз" Width="1180" Height="760" MinWidth="1000" MinHeight="680"
        Background="#FF17131F" Foreground="White" FontFamily="Segoe UI" Icon="pack://application:,,,/icon.ico"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>
    <Border Background="#FF17131F" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Инструменты -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактор баз" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentPaleBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text=" БЕТА " FontSize="10" FontWeight="Bold" Foreground="#FF17131F" Background="{DynamicResource AccentBrush}"/>
                        <Run Text=" ЛКМ — поставить, ПКМ — убрать, Ctrl+Z — отменить"/>
                    </TextBlock>
                    <TextBlock Text="ОСНОВА" Style="{StaticResource Head}"/>
                    <WrapPanel x:Name="ToolsBase"/>
                    <TextBlock Text="СТЕНЫ" Style="{StaticResource Head}"/>
                    <WrapPanel x:Name="ToolsWalls"/>
                    <TextBlock Text="ЭТАЖИ" Style="{StaticResource Head}"/>
                    <WrapPanel x:Name="ToolsFloors"/>
                    <TextBlock Text="ВНУТРИ" Style="{StaticResource Head}"/>
                    <WrapPanel x:Name="ToolsInside"/>

                    <!-- Параметры выбранного инструмента -->
                    <StackPanel x:Name="DoorOptions" Margin="0,8,0,0">
                        <TextBlock Text="Дверь" FontSize="12" Opacity="0.7"/>
                        <ComboBox x:Name="DoorBox"/>
                        <TextBlock Text="Замок" FontSize="12" Opacity="0.7"/>
                        <ComboBox x:Name="LockBox"/>
                        <CheckBox x:Name="EntranceBox" Foreground="White" Content="Главный вход (стрелка «вход»)"/>
                    </StackPanel>
                    <StackPanel x:Name="WindowOptions" Margin="0,8,0,0">
                        <TextBlock Text="Бойница" FontSize="12" Opacity="0.7"/>
                        <ComboBox x:Name="EmbrasureBox"/>
                    </StackPanel>
                    <StackPanel x:Name="ItemOptions" Margin="0,8,0,0">
                        <TextBlock Text="Предмет" FontSize="12" Opacity="0.7"/>
                        <ComboBox x:Name="ItemBox"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Холст -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                    <StackPanel x:Name="FloorTabs" Orientation="Horizontal" DockPanel.Dock="Left"/>
                    <Button Content="Очистить" DockPanel.Dock="Right" Click="Clear_Click" Margin="6,0,0,0"/>
                    <Button Content="↶ Отменить" DockPanel.Dock="Right" Click="Undo_Click"/>
                </DockPanel>
                <TextBlock x:Name="HintText" DockPanel.Dock="Bottom" FontSize="12" Foreground="{DynamicResource AccentPaleBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="32"/>
                <Border Background="#33000000" CornerRadius="6" ClipToBounds="True">
                    <Grid x:Name="Board" Background="Transparent" Width="640" Height="560"
                          MouseMove="Board_MouseMove" MouseLeave="Board_MouseLeave"
                          MouseLeftButtonDown="Board_LeftDown" MouseRightButtonDown="Board_RightDown">
                        <Canvas x:Name="GridLayer" Width="640" Height="560" IsHitTestVisible="False"/>
                        <Canvas x:Name="PlanLayer" Width="640" Height="560" IsHitTestVisible="False"/>
                        <Canvas x:Name="HoverLayer" Width="640" Height="560" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Свойства базы -->
            <DockPanel Grid.Column="4">
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button x:Name="SaveBtn" Content="💾 Сохранить в мои базы" Style="{StaticResource PrimaryButton}" Padding="12,7" FontSize="14"
                            Click="Save_Click" Margin="0,0,0,6"/>
                    <Button Content="Выложить в каталог" Click="Publish_Click" Padding="12,6"
                            ToolTip="Сохранит и откроет GitHub с готовым файлом — останется подтвердить"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Название" FontSize="12" Opacity="0.7"/>
                        <TextBox x:Name="NameBox" Padding="6,4" Margin="0,2,0,8" Background="#22FFFFFF" Foreground="White"
                                 BorderBrush="#33FFFFFF" CaretBrush="White" TextChanged="Meta_Changed"/>
                        <TextBlock Text="Описание" FontSize="12" Opacity="0.7"/>
                        <TextBox x:Name="DescBox" Padding="6,4" Margin="0,2,0,8" Background="#22FFFFFF" Foreground="White" Height="78"
                                 BorderBrush="#33FFFFFF" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" TextChanged="Meta_Changed"/>
                        <TextBlock Text="Автор (необязательно)" FontSize="12" Opacity="0.7"/>
                        <TextBox x:Name="AuthorBox" Padding="6,4" Margin="0,2,0,8" Background="#22FFFFFF" Foreground="White"
                                 BorderBrush="#33FFFFFF" CaretBrush="White" TextChanged="Meta_Changed"/>
                        <TextBlock Text="Улучшать до" FontSize="12" Opacity="0.7"/>
                        <ComboBox x:Name="TierBox" SelectionChanged="Tier_Changed"/>
                        <TextBlock Text="ИТОГО" Style="{StaticResource Head}"/>
                        <TextBlock x:Name="StatsText" FontSize="12" TextWrapping="Wrap" Opacity="0.85"/>
                        <TextBlock x:Name="CostText" FontSize="12" Foreground="{DynamicResource AccentPaleBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="ПРОВЕРКА" Style="{StaticResource Head}"/>
                        <TextBlock x:Name="ChecksText" FontSize="12" TextWrapping="Wrap" Opacity="0.85"/>
                        <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Шаги постройки собираются сами: фундаменты → шкаф → стены → двери → окна → подъём → перекрытие, этаж за этажом, мебель в конце."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
