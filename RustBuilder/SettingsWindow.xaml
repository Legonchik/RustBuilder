<Window x:Class="RustBuilder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustBuilder — Настройки" Width="580" Height="760"
        Background="#FF17131F" Foreground="White" FontFamily="Segoe UI" Icon="pack://application:,,,/icon.ico"
        Topmost="True" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF17131F">
    <Border Background="#FF17131F" Padding="20">
        <StackPanel>
            <TextBlock Text="Оверлей" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <CheckBox x:Name="SimpleMode" Foreground="White" Click="Option_Changed" Margin="0,0,0,8">
                <TextBlock TextWrapping="Wrap" Text="Простой режим: крупно и коротко, без цен и длинных пояснений"/>
            </CheckBox>
            <CheckBox x:Name="VoiceEnabled" Foreground="White" Click="Option_Changed" Margin="0,0,0,4">
                <TextBlock TextWrapping="Wrap" Text="Озвучка: программа говорит голосом, что ставить"/>
            </CheckBox>
            <DockPanel x:Name="VoicePanel" Margin="22,0,0,8">
                <Button DockPanel.Dock="Right" Content="🔊 Проверить" Click="TestVoice_Click" Margin="8,0,0,0"/>
                <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Text="Громкость" Width="80" VerticalAlignment="Center"/>
                <Slider x:Name="VolumeSlider" Minimum="10" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
            </DockPanel>
            <TextBlock x:Name="VoiceMissing" Foreground="#FFFF6B6B" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8" Visibility="Collapsed"
                       Text="Русский голос в Windows не найден. Установи: Параметры → Время и язык → Речь → Добавить голоса → Русский."/>
            <CheckBox x:Name="InteriorsEnabled" Foreground="White" Click="Option_Changed" Margin="0,0,0,8">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Варианты интерьера"/>
                    <Run Text=" БЕТА " FontSize="10" FontWeight="Bold" Foreground="#FF17131F" Background="{DynamicResource AccentBrush}"/>
                    <Run Text=": мебель (ящики, печки, верстаки) последними шагами. Выключи — базы строятся без мебели, выбор интерьера пропадёт."/>
                </TextBlock>
            </CheckBox>
            <CheckBox x:Name="PieceByPiece" Foreground="White" Click="Option_Changed">
                <TextBlock TextWrapping="Wrap" Text="По одному блоку: «Далее» подсвечивает следующий блок, а не весь шаг сразу (рекомендуется)"/>
            </CheckBox>

            <DockPanel Margin="0,12,0,0">
                <TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Text="Размер" Width="150" VerticalAlignment="Center"/>
                <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Text="Непрозрачность фона" Width="150" VerticalAlignment="Center"/>
                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="⟳ Повернуть" Click="Rotate_Click"/>
                <TextBlock x:Name="RotationText" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Совет: встань лицом к входу снаружи базы и поверни схему так, чтобы стрелка «вход» была внизу. Тогда «левая/правая сторона» на схеме совпадёт с тем, что ты видишь."/>

            <TextBlock Text="Цвет интерфейса" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <WrapPanel x:Name="ColorSwatches"/>
            <CheckBox x:Name="Animations" Foreground="White" Click="Option_Changed" Margin="0,8,0,0"
                      Content="Анимации: появление окон и схемы"/>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="▶ Показать" Click="ShowSplash_Click"/>
                <CheckBox x:Name="Splash" Foreground="White" Click="Option_Changed" VerticalAlignment="Center"
                          Content="Заставка при запуске (логотип, кольца, вспышка)"/>
            </DockPanel>

            <TextBlock Text="Что на схеме" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,4"/>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Так выглядит каждый блок и предмет на схеме в оверлее."/>
            <StackPanel x:Name="LegendList"/>

            <TextBlock Text="Обновления" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Проверить сейчас" Click="CheckUpdate_Click"/>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center"/>
            </DockPanel>
            <CheckBox x:Name="AutoUpdate" Foreground="White" Click="Option_Changed" Margin="0,8,0,0"
                      Content="Проверять обновления при запуске"/>
            <CheckBox x:Name="DiscordBox" Foreground="White" Click="Option_Changed" Margin="0,8,0,0"
                      Content="Статус в Discord: какую базу строю и на каком шаге"/>
            <CheckBox x:Name="SoundsBox" Foreground="White" Click="Option_Changed" Margin="0,8,0,0"
                      Content="Звуки интерфейса (лайк, шаг, база готова)"/>

            <Border Background="#22FF8FA8" BorderBrush="#55FF8FA8" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="❤ Поддержать" Click="Support_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                               Text="RustBuilder бесплатный и без рекламы. Если он помог тебе отстроиться — можно поддержать автора донатом. Это по желанию, все функции и так открыты."/>
                </DockPanel>
            </Border>

            <TextBlock Text="Горячие клавиши" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="Нажми на кнопку и затем нужное сочетание. Esc — отмена, Backspace — убрать клавишу. Работают прямо в игре. Лучше с Ctrl/Alt/Shift, чтобы не мешали управлению в Rust."/>
            <ItemsControl x:Name="HotkeyList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Button DockPanel.Dock="Right" Width="210" Content="{Binding Display}" Tag="{Binding}" Click="Bind_Click"
                                    HorizontalContentAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Вернуть клавиши по умолчанию" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetKeys_Click"/>
            <TextBlock x:Name="KeyMessage" Foreground="{DynamicResource AccentPaleBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Каталог баз" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
            <TextBlock Text="Репозиторий GitHub (владелец/репозиторий):" FontSize="12" Opacity="0.7"/>
            <TextBox x:Name="RepoBox" Margin="0,4,0,0" Padding="6,3" Background="#22FFFFFF" Foreground="White"
                     BorderBrush="#33FFFFFF" CaretBrush="White" LostFocus="Repo_LostFocus"/>

            <Button Content="Готово" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="24,6" Margin="0,20,0,0" Click="Done_Click"/>
        </StackPanel>
    </Border>
    </ScrollViewer>
</Window>
