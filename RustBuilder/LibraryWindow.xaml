<Window x:Class="RustBuilder.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustBuilder — Базы" Width="820" Height="560" MinWidth="700" MinHeight="460"
        Background="#FF16181B" Foreground="White" FontFamily="Segoe UI"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <Border Background="#FF16181B" Padding="16">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Левая колонка: список баз -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
            <TextBlock Text="Базы" FontSize="20" FontWeight="SemiBold"/>
            <TextBox x:Name="Search" Margin="0,8,0,0" Padding="6,4" Background="#22FFFFFF" Foreground="White"
                     BorderBrush="#33FFFFFF" CaretBrush="White" TextChanged="Search_TextChanged"
                     ToolTip="Поиск по названию"/>
        </StackPanel>

        <ListBox x:Name="List" Grid.Row="1" Grid.Column="0" Background="#11FFFFFF" BorderThickness="0"
                 Foreground="White" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <WrapPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
            <Button Content="Каталог онлайн…" Style="{StaticResource PrimaryButton}" Click="Catalog_Click" Margin="0,0,6,6"/>
            <Button Content="Загрузить свою базу…" Click="Import_Click" Margin="0,0,6,6"/>
            <Button Content="Открыть папку" Click="OpenFolder_Click" Margin="0,0,6,6"/>
        </WrapPanel>

        <!-- Правая колонка: превью -->
        <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" Foreground="#FFE0583A" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DescText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock x:Name="StatsText" FontSize="12" Opacity="0.8" TextWrapping="Wrap"/>
                <TextBlock x:Name="CostText" FontSize="12" Foreground="#FFFFB070" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" x:Name="FloorTabs"/>
            <Border Background="#33000000" CornerRadius="6">
                <Canvas x:Name="Preview" Width="440" Height="300" ClipToBounds="True"/>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0" LastChildFill="False" VerticalAlignment="Top">
            <Button x:Name="ChooseBtn" DockPanel.Dock="Right" Content="Строить эту базу" Style="{StaticResource PrimaryButton}"
                    Padding="18,6" FontSize="14" Click="Choose_Click"/>
            <Button x:Name="ExportBtn" DockPanel.Dock="Left" Content="Экспорт…" Click="Export_Click" Margin="0,0,6,0"
                    ToolTip="Сохранить .json, чтобы отправить другу"/>
            <Button x:Name="UploadBtn" DockPanel.Dock="Left" Content="Выложить" Click="Upload_Click" Margin="0,0,6,0"
                    ToolTip="Откроет GitHub с готовым файлом — останется подтвердить"/>
            <Button x:Name="DeleteBtn" DockPanel.Dock="Left" Content="Удалить" Click="Delete_Click"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>
