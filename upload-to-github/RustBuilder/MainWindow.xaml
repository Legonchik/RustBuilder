<Window x:Class="RustBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustBuilder" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" Left="24" Top="140"
        FontFamily="Segoe UI">
    <Border x:Name="Root" Width="420" CornerRadius="8" Background="#D915121C" BorderBrush="#40FFFFFF" BorderThickness="1" Padding="12">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel x:Name="Body">
            <!-- Панель управления: видна, когда окно разблокировано -->
            <DockPanel x:Name="Toolbar" Margin="0,0,0,10" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="⠿ тащи мышью" Foreground="#80FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="✕" Click="Exit_Click" Margin="6,0,0,0" ToolTip="Закрыть RustBuilder"/>
                <Button DockPanel.Dock="Right" Content="⚙" Click="Settings_Click" Margin="6,0,0,0" ToolTip="Настройки и клавиши"/>
                <Button DockPanel.Dock="Right" Content="Закрепить" Click="Lock_Click" Margin="6,0,0,0"
                        ToolTip="Окно перестанет мешать кликам в игре"/>
                <Button DockPanel.Dock="Right" Content="Базы" Style="{StaticResource PrimaryButton}" Click="Library_Click"/>
            </DockPanel>

            <DockPanel>
                <TextBlock x:Name="StepCounter" DockPanel.Dock="Right" Foreground="#B0FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                <Image x:Name="Logo" DockPanel.Dock="Left" Source="pack://application:,,,/icon.ico" Width="24" Height="24" Margin="0,0,8,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border x:Name="AuthorBadge" DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Margin="6,0,8,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="AuthorBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                </Border>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <!-- Прогресс всей постройки -->
            <Grid x:Name="ProgressBox" Height="6" Margin="0,6,0,0">
                <Border Background="#26FFFFFF" CornerRadius="3"/>
                <Border x:Name="ProgressFill" Background="{DynamicResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="FloorText" Foreground="#90FFFFFF" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

            <Border x:Name="PlanBox" Background="#33000000" CornerRadius="4" Margin="0,8,0,8">
                <Canvas x:Name="Plan" Width="394" Height="280" ClipToBounds="True"/>
            </Border>

            <!-- Что ставить прямо сейчас: крупно -->
            <Border x:Name="PieceBox" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" CornerRadius="0,6,6,0" Padding="10,8">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="60" Height="60" Background="#40000000" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Canvas x:Name="PieceIcon" Width="52" Height="52"/>
                    </Border>
                    <TextBlock x:Name="PieceCounter" DockPanel.Dock="Right" Foreground="{DynamicResource AccentPaleBrush}" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Top" Margin="8,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PieceTitle" Foreground="White" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PieceWhere" Foreground="{DynamicResource AccentWhiteBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PieceExtra" Foreground="#C8FFFFFF" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock x:Name="StepText" Foreground="#C8FFFFFF" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="StepCost" Foreground="{DynamicResource AccentPaleBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="TotalCost" Foreground="#90FFFFFF" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>

            <!-- Навигация мышью (в разблокированном режиме) -->
            <DockPanel x:Name="NavBar" Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="◀" Click="Prev_Click" ToolTip="Назад"/>
                <Button DockPanel.Dock="Left" Content="Далее ▶" Click="Next_Click" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}"/>
                <Button DockPanel.Dock="Left" Content="🔊" Click="Speak_Click" Margin="6,0,0,0" ToolTip="Повторить голосом"/>
                <Button DockPanel.Dock="Right" Content="⟳" Click="Rotate_Click" Margin="6,0,0,0" ToolTip="Повернуть схему, чтобы она совпала с тем, как ты стоишь"/>
                <Button DockPanel.Dock="Right" Content="Этаж ▲" Click="FloorUp_Click" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Этаж ▼" Click="FloorDown_Click"/>
            </DockPanel>

            <TextBlock x:Name="Hint" Foreground="#70FFFFFF" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
