<Window x:Class="RustBuilder.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustBuilder — Каталог баз" Width="1010" Height="720" MinWidth="700" MinHeight="520"
        Background="#FF17131F" Foreground="White" FontFamily="Segoe UI" Icon="pack://application:,,,/icon.ico"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid Background="#FF17131F">
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right" Content="⟳ Обновить" Click="Refresh_Click" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Каталог баз" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentLightBrush}"/>
                <TextBlock Text="Базы игроков и Claude. Лайкай понравившиеся, копируй к себе и строй." FontSize="12" Opacity="0.65" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Поиск, сортировка, фильтр -->
        <DockPanel Grid.Row="1" Margin="0,14,0,10" LastChildFill="False">
            <Grid DockPanel.Dock="Left" Width="250" Margin="0,0,14,0">
                <TextBox x:Name="Search" Padding="8,5" Background="#22FFFFFF" Foreground="White"
                         BorderBrush="#33FFFFFF" CaretBrush="White" TextChanged="Search_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="🔍 Поиск по названию или автору" Margin="11,6,0,0" Opacity="0.4" IsHitTestVisible="False"/>
            </Grid>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" x:Name="SortPanel" Margin="0,0,14,0"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" x:Name="FilterPanel"/>
            <TextBlock DockPanel.Dock="Right" x:Name="CountText" VerticalAlignment="Center" Opacity="0.55" FontSize="12"/>
        </DockPanel>

        <!-- Карточки -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="Cards" Margin="0,0,0,8"/>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="24" Opacity="0.75" FontSize="14"/>
            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                    Background="#F02A2433" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10"
                    Padding="16,9" Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="13" TextWrapping="Wrap" MaxWidth="520"/>
            </Border>
        </Grid>

        <!-- Источник и подсказка -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Источник:" FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="RepoBox" Width="200" Padding="5,2" FontSize="11" Background="#22FFFFFF" Foreground="White"
                         BorderBrush="#33FFFFFF" CaretBrush="White" ToolTip="Репозиторий каталога на GitHub: владелец/репозиторий"/>
                <Button Content="OK" Click="SaveRepo_Click" Margin="6,0,0,0" Padding="8,2" FontSize="11"/>
            </StackPanel>
            <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"
                       Text="♥ открывает страницу базы на GitHub: поставь там 👍 — это лайк (нужен аккаунт GitHub, один аккаунт — один лайк). Клик по схеме — следующий этаж."/>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
