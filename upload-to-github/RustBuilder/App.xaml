<Application x:Class="RustBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Цвет интерфейса: меняется в настройках (Theme.Apply) -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FFA970FF"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#FF7C3AED"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFB794FF"/>
        <SolidColorBrush x:Key="AccentPaleBrush" Color="#FFC9A8FF"/>
        <SolidColorBrush x:Key="AccentWhiteBrush" Color="#FFE2D2FF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#33A970FF"/>

        <!-- Тёмная кнопка -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная (фиолетовая) кнопка -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Resources>
</Application>
